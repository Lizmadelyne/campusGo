<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PanelEstudiante">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="251dp"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="Bienvenido Juan Perez"
            android:textColor="#314AC7"
            android:textSize="20sp"
            android:visibility="visible" />

        <GridLayout
            android:id="@+id/gridPanelEstudiante"
            android:layout_width="match_parent"
            android:layout_height="344dp"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:columnOrderPreserved="false"
            android:padding="16dp"
            android:rowCount="2">

            <Button
                android:id="@+id/btnMisActividades"
                android:layout_width="10dp"
                android:layout_height="143dp"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:background="#2196F3"
                android:text="Mis actividades"
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                tools:textSize="20sp" />

            <Button
                android:id="@+id/btnPerfil"
                android:layout_width="15dp"
                android:layout_height="135dp"
                android:layout_columnWeight="1"
                android:background="#E976B2"
                android:text="Perfil"
                tools:textSize="20sp" />

            <Button
                android:id="@+id/btnEvidencias"
                android:layout_width="0dp"
                android:layout_height="122dp"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:background="#FF9800"
                android:text="Evidencias"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnNotificaciones"
                android:layout_width="0dp"
                android:layout_height="136dp"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:backgroundTint="#2DD931"
                android:text="Notificaciones"
                android:textSize="18sp" />

        </GridLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>