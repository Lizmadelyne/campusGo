<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".evidencias">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2F3F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título -->
            <TextView
                android:id="@+id/tvTituloEvidencias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis Evidencias"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="16dp"/>

            <!-- Card de evidencia -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardEvidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Nombre de la evidencia -->
                    <TextView
                        android:id="@+id/tvNombreEvidencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informe de laboratorio"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <!-- Fecha -->
                    <TextView
                        android:id="@+id/tvFechaEvidencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subida: 25 sept. 2026"
                        android:textSize="14sp"
                        android:textColor="#777777"
                        android:layout_marginTop="6dp"/>

                    <!-- Descripción -->
                    <TextView
                        android:id="@+id/tvDescripcionEvidencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Archivo PDF con resultados del laboratorio de Física."
                        android:textSize="14sp"
                        android:textColor="#4B5563"
                        android:layout_marginTop="10dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón para agregar evidencia -->
            <Button
                android:id="@+id/btnAgregarEvidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#F57C00"
                android:text="Agregar nueva evidencia"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>